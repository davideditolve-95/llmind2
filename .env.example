# .env.example — Template delle variabili d'ambiente
# Copia questo file in .env e compila i valori per il tuo ambiente

POSTGRES_USER=llmind_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=llmind_db
DATABASE_URL=postgresql://llmind_user:your_secure_password_here@db:5432/llmind_db

ICD11_API_URL=http://icd11-api
ICD11_CLIENT_ID=
ICD11_CLIENT_SECRET=

# Locale: http://host.docker.internal:11434
# Coolify: https://ollama.tuodominio.com
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_DEFAULT_MODEL=gemma4
OLLAMA_API_KEY=

SECRET_KEY=genera_una_chiave_casuale_sicura_di_almeno_32_caratteri
ENVIRONMENT=production
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://frontend:3000
CORS_ALLOWED_ORIGIN_REGEX=https://.*\.sslip\.io

# URL pubblico del backend (Coolify: es. https://api.tuodominio.com)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Authentik OIDC Config
AUTHENTIK_ISSUER_URL=https://authentikserver-np2kpr6ek51bua2mbx86nsxt.89.168.29.98.sslip.io/application/o/llmind2/
AUTHENTIK_CLIENT_ID=llmind2-client-id
AUTHENTIK_CLIENT_SECRET=llmind2-client-secret
AUTHENTIK_JWKS_URL=https://authentikserver-np2kpr6ek51bua2mbx86nsxt.89.168.29.98.sslip.io/application/o/llmind2/jwks/

# GCP Conversational Agents / Dialogflow CX
# Project PoC previsto: llmind
GCP_PROJECT_ID=llmind
GCP_LOCATION=eu
GCP_DIALOGFLOW_AGENT_ID=
GCP_DIALOGFLOW_ENVIRONMENT_ID=
# Opzionale: mappa JSON per usare agenti Dialogflow diversi per ogni agente logico LLMind.
# Esempio: {"clinical-intake":"agent-id-1","icd11-coding":"agent-id-2"}
GCP_DIALOGFLOW_AGENT_MAP=
GCP_DIALOGFLOW_API_ENDPOINT=https://dialogflow.googleapis.com
# Se vuoto usa Application Default Credentials del runtime; in Docker puoi montare il file e indicarne il path.
GCP_CREDENTIALS_FILE=
GCP_AGENTS_LANGUAGE_CODE=en
GCP_AGENTS_TIMEOUT_SECONDS=30
